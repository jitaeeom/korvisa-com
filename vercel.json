{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.korvisa.com" }],
      "destination": "https://korvisa.com/$1",
      "permanent": true
    },
    { "source": "/visa/e-7", "destination": "/visa/e7", "permanent": true },
    { "source": "/visa/e-7-1", "destination": "/visa/e7-1", "permanent": true },
    { "source": "/visa/d-8", "destination": "/visa/d8", "permanent": true },
    { "source": "/visa/f-2", "destination": "/visa/f2", "permanent": true },
    { "source": "/visa/f-5", "destination": "/visa/f5", "permanent": true },
    { "source": "/visa/f-6", "destination": "/visa/f6", "permanent": true }
  ],
  "rewrites": [
    { "source": "/visa/e7", "destination": "/visa/e7/index.html" },
    { "source": "/visa/e7-1", "destination": "/visa/e7-1/index.html" },
    { "source": "/visa/e9", "destination": "/visa/e9/index.html" },
    { "source": "/visa/f2", "destination": "/visa/f2/index.html" },
    { "source": "/visa/f5", "destination": "/visa/f5/index.html" },
    { "source": "/visa/d8", "destination": "/visa/d8/index.html" },
    { "source": "/visa/f6", "destination": "/visa/f6/index.html" },
    { "source": "/housing", "destination": "/housing/index.html" },
    { "source": "/representative", "destination": "/representative/index.html" },
    { "source": "/consult", "destination": "/spa-shell.html" },
    { "source": "/admin", "destination": "/spa-shell.html" },
    { "source": "/admin/login", "destination": "/spa-shell.html" },
    {
      "source": "/((?!.*\\..*).+)",
      "destination": "/spa-shell.html"
    }
  ]
}
